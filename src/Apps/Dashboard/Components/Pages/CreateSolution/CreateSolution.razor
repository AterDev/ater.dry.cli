@page "/create"
@using CoreMod.Services
@using Share.Models
@using Share.Models.CommandDtos
@using Share.Services
@inherits PageBase

<PageTitle>@Lang(Localizer.Create, Localizer.Solution)</PageTitle>

<div class="create-solution-page vh-default">
  <div class="create-solution-content">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12" Class="p-2">
      <FluentLabel Typo="Typography.PageTitle">
        ✨ @Lang(Localizer.Create, Localizer.Solution)
      </FluentLabel>

      <FluentLabel Typo="Typography.H3">🤟 @Lang(Localizer.Base, Localizer.Info)</FluentLabel>

      <FluentStack Orientation="Orientation.Vertical" VerticalGap="2">
        <FluentTextField Label="@Lang(Localizer.Solution, Localizer.Name)" Class="w-240" AutoComplete="off"
                         Placeholder="@Lang(Localizer.Solution, Localizer.Name)" @bind-Value="AddDto.Name" Required="true" />
      </FluentStack>

      <FluentStack Orientation="Orientation.Vertical" VerticalGap="2">
        <FluentTextField Label="@Lang(Localizer.Local, Localizer.Path)" @bind-Value="AddDto.Path" Class="w-240"
                         AutoComplete="off" Placeholder="@Lang(Localizer.Local,Localizer.Path)" Required="true" />
      </FluentStack>

      <FluentLabel>
        @if (!string.IsNullOrWhiteSpace(AddDto.Path))
        {
          <span>Solution File: </span>
          <strong>@AddDto.Path\@AddDto.Name\@(AddDto.Name).slnx</strong>
        }
      </FluentLabel>

      <FluentLabel>
        @Lang(Localizer.SolutionType)
      </FluentLabel>
      <FluentRadioGroup TOption="string" Orientation="Orientation.Vertical" Required="true"
                        @bind-Value="SelectedTemplateType">
        @foreach (TemplateTypeOption option in TemplateTypeOptions)
        {
          <FluentRadio TOption="string" Value="@option.Value" Label="@option.Text" />
        }
      </FluentRadioGroup>

      <FluentDivider Class="w-100" />
      <FluentLabel Typo="Typography.H3">
        📚 @Lang(Localizer.Component, Localizer.Configuration)
      </FluentLabel>

      <FluentLabel Typo="Typography.Subject">@Lang(Localizer.DatabaseProvider)</FluentLabel>

      <FluentStack Orientation="Orientation.Vertical" VerticalGap="2">
        <FluentSelect TOption="DBType" Items="@(GetAvailableDatabaseTypes())" Width="240px"
                      @bind-SelectedOption="@AddDto.DBType" />
      </FluentStack>

      <FluentSpacer></FluentSpacer>
      <FluentLabel Typo="Typography.Subject">@Lang(Localizer.CacheType)</FluentLabel>

      <FluentStack Orientation="Orientation.Vertical" VerticalGap="2">
        <FluentSelect TOption="CacheType" Items="@(Enum.GetValues<CacheType>())"
                      @bind-SelectedOption="@AddDto.CacheType" Width="240px" />
      </FluentStack>
      @if (!AddDto.IsLight)
      {
        <FluentDivider Class="w-100"></FluentDivider>

        <FluentLabel Typo="Typography.H3">
          🎁 @Lang(Localizer.FeatureModules)
        </FluentLabel>

        @if (IsLoadingOfficialModules)
        {
          <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
            <FluentProgressRing />
            <FluentLabel>@Lang(Localizer.LoadingOfficialModules)</FluentLabel>
          </FluentStack>
        }
        else if (!string.IsNullOrWhiteSpace(OfficialModuleLoadError))
        {
          <FluentMessageBar Intent="MessageIntent.Warning">
            @OfficialModuleLoadError
          </FluentMessageBar>
        }
        else if (OfficialModuleOptions.Count == 0)
        {
          <FluentLabel>@Lang(Localizer.OfficialModuleListEmpty)</FluentLabel>
        }
        else
        {
          <div class="official-module-list">
            @foreach (var module in OfficialModuleOptions)
            {
              <div class="official-module-row">
                <FluentCheckbox @bind-Value="module.IsSelected" />
                <div class="official-module-info">
                  <FluentLabel Typo="Typography.Body" Class="official-module-summary">
                    @GetOfficialModuleSummary(module.Metadata)
                  </FluentLabel>
                </div>
              </div>
            }
          </div>
        }
      }

      <FluentDivider Class="w-100"></FluentDivider>

      <FluentLabel Typo="Typography.H3">
        🅰️ @Lang(Localizer.FrontEnd, Localizer.Integration)
      </FluentLabel>

      <FluentLabel Typo="Typography.Subject">@Lang(Localizer.SelectFrontType)</FluentLabel>

      <FluentSelect TOption="FrontType" Items="@(Enum.GetValues<FrontType>())" @bind-SelectedOption="@AddDto.FrontType"
                    Width="240px" />

      <FluentStack Orientation="Orientation.Vertical" Class="mt-2">
        <FluentStack HorizontalAlignment="HorizontalAlignment.Right">
          <FluentButton Appearance="Appearance.Accent" OnClick="OpenSplashDefaultAsync" Disabled="!IsValid()">
            🎊@Lang(Localizer.Create, Localizer.Solution)
          </FluentButton>
        </FluentStack>
      </FluentStack>
    </FluentStack>
  </div>
</div>

@code {
  CreateSolutionDto AddDto { get; set; } = null!;
  List<OfficialModuleOption> OfficialModuleOptions { get; set; } = [];
  bool IsProcessing { get; set; } = false;
  bool IsLoadingOfficialModules { get; set; }
  string? OfficialModuleLoadError { get; set; }
  private string _selectedTemplateType = "standard";
  string SelectedTemplateType
  {
    get => _selectedTemplateType;
    set
    {
      if (string.IsNullOrWhiteSpace(value))
      {
        return;
      }

      _selectedTemplateType = value;
      AddDto.IsLight = value == "light";
      AddDto.ApplyTemplateDefaults();
      _ = LoadOfficialModulesAsync();
    }
  }
  List<TemplateTypeOption> TemplateTypeOptions { get; set; } = [];

  private sealed class TemplateTypeOption
  {
    public required string Value { get; init; }

    public required string Text { get; init; }
  }

  private sealed class OfficialModuleOption
  {
    public required PackageMetadata Metadata { get; set; }

    public bool IsSelected { get; set; }
  }

  [Inject]
  private CommandService CommandService { get; set; } = null!;

  [Inject]
  private OfficialModuleService OfficialModuleService { get; set; } = null!;

  private IDialogReference? _dialog;

  protected override void OnInitialized()
  {
    AddDto = new CreateSolutionDto
    {
      Name = string.Empty,
      Path = string.Empty,
      CacheType = CacheType.Memory,
      DBType = DBType.PostgreSQL,
      IsLight = false,
    };
    TemplateTypeOptions =
    [
      new() { Value = "standard", Text = Lang(Localizer.SolutionTypeStandard) },
      new() { Value = "light", Text = Lang(Localizer.SolutionTypeMini) }
    ];
    SelectedTemplateType = "standard";
    _ = LoadOfficialModulesAsync();
  }

  private bool IsValid()
  {
    return !string.IsNullOrWhiteSpace(AddDto.Path) &&
           !string.IsNullOrWhiteSpace(AddDto.Name);

  }

  private IReadOnlyList<DBType> GetAvailableDatabaseTypes()
  {
    return AddDto.GetAvailableDatabaseTypes();
  }

  private async Task OpenSplashDefaultAsync()
  {
    if (!IsValid())
    {
      ToastService.ShowError(Lang(Localizer.FormValidFailed));
      return;
    }

    AddDto.OfficialModules = OfficialModuleOptions
      .Where(p => p.IsSelected)
      .Select(p => $"Perigon.{p.Metadata.ModuleName}")
      .ToList();

    DialogParameters<SplashScreenContent> parameters = new()
    {
      Content = new()
      {
        DisplayTime = 0,
        Title = Lang(Localizer.Create, Localizer.Solution),
        SubTitle = $"{AddDto.Path}\\{AddDto.Name}\\{AddDto.Name}.slnx",
        LoadingText = "🚀 Running...",
      },
      PreventDismissOnOverlayClick = true,
      Modal = false,
      Width = "520px",
      Height = "360px",
    };
    _dialog = await DialogService.ShowSplashScreenAsync(parameters);
    var splashScreen = (SplashScreenContent)_dialog.Instance.Content;

    splashScreen.UpdateLabels(loadingText: "⏲️ Wait seconds...");
    var res = await CommandService.CreateSolutionAsync(AddDto);

    splashScreen.UpdateLabels(message: (MarkupString)(res ? "🎉 Success!" : "❌ Failed!"), loadingText: "Create completed! To home page.");
    await Task.Delay(1000);
    await _dialog.CloseAsync();
    if (res)
    {
      NavigationManager.NavigateTo("/");
    }
  }

  private async Task LoadOfficialModulesAsync()
  {
    if (AddDto.IsLight)
    {
      OfficialModuleOptions = [];
      OfficialModuleLoadError = null;
      IsLoadingOfficialModules = false;
      await InvokeAsync(StateHasChanged);
      return;
    }

    IsLoadingOfficialModules = true;
    OfficialModuleLoadError = null;

    try
    {
      var modules = await OfficialModuleService.GetOfficialModulesAsync();
      OfficialModuleOptions = modules
        .Select(module => new OfficialModuleOption { Metadata = module })
        .ToList();
    }
    catch (Exception ex)
    {
      OfficialModuleLoadError = ex.Message;
    }
    finally
    {
      IsLoadingOfficialModules = false;
      await InvokeAsync(StateHasChanged);
    }
  }

  private static string GetOfficialModuleSummary(PackageMetadata module)
  {
    var displayName = string.IsNullOrWhiteSpace(module.DisplayName)
      ? $"Perigon.{module.ModuleName}"
      : module.DisplayName;
    var description = string.IsNullOrWhiteSpace(module.Description)
      ? "-"
      : module.Description;

    return $"{displayName}({module.Version}) - {description}";
  }
}

<style>
  .create-solution-page {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .create-solution-content {
    width: min(100%, 860px);
    max-width: 860px;
  }

  .official-module-list {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .official-module-row {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    gap: 4px;
    align-items: start;
    padding: 10px 0;
  }

  .official-module-info {
    min-width: 0;
  }

  .official-module-summary {
    overflow-wrap: anywhere;
  }
</style>
