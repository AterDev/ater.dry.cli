{
  "name": "ater.dry",
  "version": "0.2.1",
  "description": "DryGen OpenAPI client generator (axios/angular) implemented in Node.js",
  "private": false,
  "type": "commonjs",
  "bin": {
    "drygen": "bin/drygen.js"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "scripts": {
    "start": "node ./bin/drygen.js",
    "smoke": "node -e \"const { getSupportedRequestTypes } = require('./src'); console.log(getSupportedRequestTypes().join(','));\""
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "commander": "^14.0.0"
  }
}
